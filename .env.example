# Copy to .env and change the secrets. docker compose reads .env automatically.
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# Shared by backends and load balancer (the LB verifies user sessions to attribute requests). >= 16 chars.
JWT_SECRET=change-me-to-a-long-random-string
# Admin dashboard login (/admin/login)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# Load balancer behaviour (all of these except BACKEND_URLS can also be changed live from the dashboard)
ALGORITHM=round_robin            # round_robin | weighted_round_robin | least_connections | ip_hash
BACKEND_URLS=http://backend-1:8001,http://backend-2:8002,http://backend-3:8003
BACKEND_WEIGHTS=5,3,1
HEALTH_CHECK_INTERVAL=2s
REQUEST_TIMEOUT=30s
BACKEND_TIMEOUT=10s
CONNECT_TIMEOUT=2s
RETRY_COUNT=2
RATE_LIMIT=0                     # requests/second per client IP; 0 disables rate limiting
LOG_LEVEL=info
BCRYPT_COST=10                   # lower (e.g. 6) for very heavy login load tests
COOKIE_SECURE=false              # set true when serving over HTTPS

# ---- Separated frontends -------------------------------------------------------------------------
# URL the BROWSER uses to reach the load balancer (API entry point). Change per environment, e.g.
# https://api.yourshop.com in production. Written to config.js at container start: no rebuild needed.
SHOP_API_URL=http://localhost:8080
ADMIN_API_URL=http://localhost:8080
# Origins allowed to call the load balancer from a browser, comma separated, exact match.
# Production example: https://yourshop.com,https://dashboard.yourshop.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Cookie SameSite: lax works when shop, dashboard and API share the same site (localhost, or
# yourshop.com + api.yourshop.com). Use "none" (requires COOKIE_SECURE=true / HTTPS) if they are on different domains.
COOKIE_SAMESITE=lax
